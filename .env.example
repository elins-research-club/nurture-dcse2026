# G-Connect Global Environment Configuration Example

# Backend Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gconnect
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/gconnect
SECRET_KEY=change-this-in-production-long-secret-key-32-chars

# Frontend Settings (Public variables exposed to browser)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws
