PROJECT_NAME="G-Connect API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Replace with strong random string in production)
SECRET_KEY="generate-long-random-string-for-jwt-signing-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/gconnect"
